ader(http.StatusForbidden)\n\t\t\t_, _ = w.Write([]byte(`{\"message\":\"Forbidden\"}`))\n\t\t}))\n\t\tDeferCleanup(srv.Close)\n\n\t\tclient := pkg.NewGitHubClientWithBaseURL(\"tok\", srv.URL)\n\t\t_, err := client.GetPullRequest(ctx, \"bborbe\", \"sandbox\", 7)\n\t\tExpect(err).NotTo(BeNil())\n\t\tExpect(err.Error()).To(ContainSubstring(\"HTTP 403\"))\n\t\tExpect(atomic.LoadInt32(&requests)).To(Equal(int32(1)))\n\t})\n})\n","structuredPatch":[{"oldStart":140,"oldLines":15,"newStart":140,"newLines":15,"lines":["   })"," ","   It(\"bounds the accumulated retry sleep inside the client timeout\", func() {","-    // MaxWait bounds a single wait, so a persistent short Retry-After is","-    // slept MaxAttempts times inside one client.Do. The one-second bound","-    // keeps that budget at five seconds, inside the 15-second client","-    // timeout: the exhausted retries surface the real 429, not a","-    // context-deadline cancellation.","+    // A four-second Retry-After is at or below a five-second MaxWait, so","+    // under that old bound it would be slept once per attempt — 5 × 4s =","+    // 20s total, past the 15-second client timeout. At the one-second","+    // bound it exceeds MaxWait and is deferred immediately, so the call","+    // returns the real 429 after a single request instead of retrying.","     var requests int32","     srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {","       atomic.AddInt32(&requests, 1)","-      w.Header().Set(\"Retry-After\", \"1\")","+      w.Header().Set(\"Retry-After\", \"4\")","       w.WriteHeader(http.StatusTooManyRequests)","     }))","     DeferCleanup(srv.Close)"]},{"oldStart":160,"oldLines":8,"newStart":160,"newLines":8,"lines":["     Expect(err).NotTo(BeNil())","     Expect(err.Error()).To(ContainSubstring(\"HTTP 429\"))","     Expect(err.Error()).NotTo(ContainSubstring(\"context deadline exceeded\"))","-    Expect(atomic.LoadInt32(&requests)).To(Equal(int32(6)))","-    Expect(e