icated GET and returns the body on HTTP 200.\nfunc (c *httpGitHubClient) get(ctx context.Context, url string) ([]byte, error) {\n\treq, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)\n\tif err != nil {\n\t\treturn nil, errors.Wrapf(ctx, err, \"build request\")\n\t}\n\treq.Header.Set(\"Accept\", \"application/vnd.github+json\")\n\tif token := c.currentToken(); token != \"\" {\n\t\treq.Header.Set(\"Authorization\", \"token \"+token)\n\t}\n\tresp, err := c.client.Do(req)\n\tif err != nil {\n\t\treturn nil, errors.Wrapf(ctx, err, \"github request\")\n\t}\n\tdefer func() { _ = resp.Body.Close() }()\n\tbody, _ := io.ReadAll(resp.Body)\n\tif resp.StatusCode != http.StatusOK {\n\t\treturn nil, errors.Errorf(\n\t\t\tctx,\n\t\t\t\"github returned HTTP %d: %s\",\n\t\t\tresp.StatusCode,\n\t\t\ttruncate(string(body)),\n\t\t)\n\t}\n\treturn body, nil\n}\n","structuredPatch":[{"oldStart":79,"oldLines":7,"newStart":79,"newLines":7,"lines":["   }","   return libhttp.NewRoundTripperRetryWithBackoff(","     http.DefaultTransport,","-    libhttp.RetryBackoffOptions{RetryHosts: hosts, MaxWait: 5 * time.Second},","+    libhttp.RetryBackoffOptions{RetryHosts: hosts, MaxWait: 1 * time.Second},","   )"," }"," "]}],"userModified":false,"replaceAll":false}}
