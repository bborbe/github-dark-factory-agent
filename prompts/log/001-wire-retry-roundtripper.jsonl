mitClassNone RateLimitClass = \"\"\n53\t\t// RateLimitClassPrimary means the primary quota is exhausted.\n54\t\tRateLimitClassPrimary RateLimitClass = \"primary\"\n55\t\t// RateLimitClassSecondary means GitHub asks for a secondary-limit backoff.\n56\t\tRateLimitClassSecondary RateLimitClass = \"secondary\"\n57\t\t// RateLimitClassUnclassified means a 429 without a recognizable limit signal.\n58\t\tRateLimitClassUnclassified RateLimitClass = \"unclassified\"\n59\t)\n60\t\n61\t// RateLimitClasses is the collection of every RateLimitClass value.\n62\ttype RateLimitClasses []RateLimitClass\n63\t\n64\t// AvailableRateLimitClasses lists every RateLimitClass value.\n65\tvar AvailableRateLimitClasses = RateLimitClasses{\n66\t\tRateLimitClassNone,\n67\t\tRateLimitClassPrimary,\n68\t\tRateLimitClassSecondary,\n69\t\tRateLimitClassUnclassified,\n70\t}\n71\t\n72\t// String returns the class as its underlying string value.\n73\tfunc (c RateLimitClass) String() string {\n74\t\treturn string(c)\n75\t}\n76\t\n77\t// ClassifyRateLimitResponse classifies a GitHub rate-limit response.\n78\t// Only 403 and 429 responses are considered; every other status returns\n79\t// RateLimitClassNone. The rules are evaluated in order and the first match wins:\n80\t// a body mentioning a secondary rate limit, a Retry-After header, exhausted\n81\t// X-RateLimit-Remaining quota (primary), positive X-RateLimit-Remaining quota on\n82\t// a 429 (secondary), and any other 429 (unclassified).\n83\tfunc ClassifyRateLimitResponse(resp *http.Response, body []byte) RateLimitClass {\n84\t\tif resp == nil {\n85\t\t\treturn RateLimitClassNone\n86\t\t}\n87\t\tif resp.StatusCode != http.StatusForbidden &&\n88\t\t\tresp.StatusCode != http.StatusTooManyRequests {\n89\t\t\treturn RateLimitClassNone\n90\t\t}\n91\t\tif strings.Contains(strings.ToLower(string(body)), \"secondary rate limit\") {\n92\t\t\treturn RateLimitClassSecondary\n93\t\t}\n94\t\tif resp.Header.Get(\"Retry-After\") != \"\" {\n95\t\t\treturn RateLimitClassSecondary\n96\t\t}\n97\t\tremaining, remainingErr := strconv.Atoi(resp.Header.Get(\"X-RateLimit-Remaining\"))\n98\t\tif remainingErr == nil && remaining == 0 {\n99\t\t\treturn RateLimitClassPrimary\n100\t\t}\n101\t\tif resp.StatusCode == http.StatusTooManyRequests {\n102\t\t\tif remainingErr == nil && remaining > 0 {\n103\t\t\t\treturn RateLimitClassSecondary\n104\t\t\t}\n105\t\t\treturn RateLimitClassUnclassified\n106\t\t}\n107\t\treturn RateLimitClassNone\n108\t}\n109\t\n110\t// NewRoundTripperRetryWithBackoff wraps a RoundTripper with rate-limit aware\n111\t// retry logic. A 403 or 429 response from one of RetryHosts that classifies as\n112\t// a rate limit is retried after the delay the response asks for.\n113\tfunc NewRoundTripperRetryWithBackoff(\n114\t\troundTripper http.RoundTripper,\n115\t\toptions RetryBackoffOptions,\n116\t) http.RoundTripper {\n117\t\tif options.MaxAttempts == 0 {\n118\t\t\toptions.MaxAttempts = 5\n119\t\t}\n120\t\tif options.MaxAttempts < 1 {\n121\t\t\toptions.MaxAttempts = 1\n122\t\t}\n123\t\tif len(options.RetryHosts) == 0 {\n124\t\t\toptions.RetryHosts = []string{\"api.github.com\"}\n125\t\t}\n126\t\tif options.Sleep == nil {\n127\t\t\toptions.Sleep = defaultRetryBackoffSleep\n128\t\t}\n129\t\tif options.Now == nil {\n130\t\t\toptions.Now = libtime.Now\n131\t\t}\n132\t\tif options.Logf == nil {\n133\t\t\toptions.Logf = glog.Warningf\n134\t\t}\n135\t\tif options.MaxWait <= 0 {\n136\t\t\toptions.MaxWait = 5 * time.Minute\n137\t\t}\n138\t\treturn &retryBackoffRoundTripper{\n139\t\t\troundTripper: roundTripper,\n140\t\t\tmaxAttempts:  options.MaxAttempts,\n141\t\t\tretryHosts:   options.RetryHosts,\n142\t\t\tsleep:        options.Sleep,\n143\t\t\tnow:          options.Now,\n144\t\t\tlogf:         options.Logf,\n145\t\t\tmaxWait:      options.MaxWait,\n146\t\t}\n147\t}\n148\t\n149\ttype retryBackoffRoundTripper struct {\n150\t\troundTripper http.RoundTripper\n151\t\tmaxAttempts  int\n152\t\tretryHosts   []string\n153\t\tsleep        func(ctx context.Context, d time.Duration) error\n154\t\tnow          func() time.Time\n155\t\tlogf         func(format string, args ...any)\n156\t\tmaxWait      time.Duration\n157\t}\n158\t\n159\tfunc (r *retryBackoffRoundTripper) RoundTrip(req *http.Request) (*http.Response, error) {\n160\t\tif !r.isRetryHost(req) {\n161\t\t\treturn r.roundTripper.RoundTrip(req)\n162\t\t}\n163\t\n164\t\tctx := req.Context()\n165\t\tbody, err := readRequestBody(req)\n166\t\tif err != nil {\n167\t\t\treturn nil, err\n168\t\t}\n169\t\n170\t\tretries := 0\n171\t\tfor {\n172\t\t\tif ctxErr := ctx.Err(); ctxErr != nil {\n173\t\t\t\treturn nil, errors.Wrap(ctx, ctxErr, \"retry cancelled\")\n174\t\t\t}\n175\t\n176\t\t\tresp, err := r.roundTripper.RoundTrip(cloneRequestWithBody(ctx, req, body))\n177\t\t\tif err != nil {\n178\t\t\t\treturn nil, errors.Wrap(ctx, err, \"roundtrip failed\")\n179\t\t\t}\n180\t\n181\t\t\tif !isRateLimitStatus(resp.StatusCode) {\n182\t\t\t\treturn resp, nil\n183\t\t\t}\n184\t\n185\t\t\trespBody, err := bufferResponseBody(resp)\n186\t\t\tif err != nil {\n187\t\t\t\treturn nil, errors.Wrap(ctx, err, \"read response body failed\")\n188\t\t\t}\n189\t\n190\t\t\tclass := ClassifyRateLimitResponse(resp, respBody)\n191\t\t\tif class == RateLimitClassNone {\n192\t\t\t\treturn resp, nil\n193\t\t\t}\n194\t\t\tif retries >= r.maxAttempts {\n195\t\t\t\tr.logf(\"retry exhausted status=%d retries=%d\", resp.StatusCode, retries)\n196\t\t\t\treturn resp, nil\n197\t\t\t}\n198\t\n199\t\t\twait := computeRetryWait(resp, r.now())\n200\t\t\tif wait > r.maxWait {\n201\t\t\t\tr.logf(\"retry deferred wait=%s\", wait)\n202\t\t\t\treturn resp, nil\n203\t\t\t}\n204\t\t\tretries++\n205\t\t\tr.logRetry(retries, resp.StatusCode, class, wait)\n206\t\t\tif err := r.sleep(ctx, wait); err != nil {\n207\t\t\t\treturn nil, errors.Wrap(ctx, err, \"retry wait cancelled\")\n208\t\t\t}\n209\t\t}\n210\t}\n211\t\n212\tfunc (r *retryBackoffRoundTripper) isRetryHost(req *http.Request) bool {\n213\t\tif req.Header.Get(PreventRetryHeaderName) != \"\" {\n214\t\t\treturn false\n215\t\t}\n216\t\thost := req.URL.Hostname()\n217\t\tfor _, retryHost := range r.retryHosts {\n218\t\t\tif retryHost == host {\n219\t\t\t\treturn true\n220\t\t\t}\n221\t\t}\n222\t\treturn false\n223\t}\n224\t\n225\tfunc (r *retryBackoffRoundTripper) logRetry(\n226\t\tattempt int,\n227\t\tstatus int,\n228\t\tclass RateLimitClass,\n229\t\twait time.Duration,\n230\t) {\n231\t\tr.logf(\"retry attempt=%d status=%d class=%s wait=%s\", attempt, status, class, wait)\n232\t}\n233\t\n234\tfunc isRateLimitStatus(statusCode int) bool {\n235\t\treturn statusCode == http.StatusForbidden || statusCode == http.StatusTooManyRequests\n236\t}\n237\t\n238\t// bufferResponseBody reads the response body to EOF, closes it and restores it\n239\t// so the caller still reads the original bytes. A nil body is treated as empty.\n240\tfunc bufferResponseBody(resp *http.Response) ([]byte, error) {\n241\t\tif resp.Body == nil {\n242\t\t\tresp.Body = io.NopCloser(bytes.NewReader(nil))\n243\t\t\treturn nil, nil\n244\t\t}\n245\t\tbody, err := io.ReadAll(resp.Body)\n246\t\tcloseErr := resp.Body.Close()\n247\t\tif err != nil {\n248\t\t\treturn nil, err\n249\t\t}\n250\t\tif closeErr != nil {\n251\t\t\treturn nil, closeErr\n252\t\t}\n253\t\tresp.Body = io.NopCloser(bytes.NewReader(body))\n254\t\treturn body, nil\n255\t}\n256\t\n257\t// computeRetryWait returns the delay requested by the response, falling back to\n258\t// the primary-quota reset time and then to one second.\n259\tfunc computeRetryWait(resp *http.Response, now time.Time) time.Duration {\n260\t\tif value := resp.Header.Get(\"Retry-After\"); value != \"\" {\n261\t\t\tif wait, ok := parseRetryAfter(value, now); ok {\n262\t\t\t\treturn wait\n263\t\t\t}\n264\t\t}\n265\t\tif value := resp.Header.Get(\"X-RateLimit-Reset\"); value != \"\" {\n266\t\t\tif reset, err := strconv.ParseInt(value, 10, 64); err == nil {\n267\t\t\t\twait := time.Unix(reset, 0).Sub(now)\n268\t\t\t\tif wait