ken, baseURL string) *httpGitHubClient {\n49\t\treturn &httpGitHubClient{\n50\t\t\ttoken:   token,\n51\t\t\tbaseURL: baseURL,\n52\t\t\tclient:  &http.Client{Timeout: 15 * time.Second},\n53\t\t}\n54\t}\n55\t\n56\ttype httpGitHubClient struct {\n57\t\ttoken   string\n58\t\tbaseURL string\n59\t\tclient  *http.Client\n60\t}\n61\t\n62\tfunc (c *httpGitHubClient) GetPullRequest(\n63\t\tctx context.Context,\n64\t\towner, repo string,\n65\t\tnumber int,\n66\t) (*PullRequestInfo, error) {\n67\t\turl := fmt.Sprintf(\"%s/repos/%s/%s/pulls/%d\", c.baseURL, owner, repo, number)\n68\t\tbody, err := c.get(ctx, url)\n69\t\tif err != nil {\n70\t\t\treturn nil, err\n71\t\t}\n72\t\tvar payload struct {\n73\t\t\tDraft bool `json:\"draft\"`\n74\t\t\tHead  struct {\n75\t\t\t\tSHA string `json:\"sha\"`\n76\t\t\t} `json:\"head\"`\n77\t\t}\n78\t\tif err := json.Unmarshal(body, &payload); err != nil {\n79\t\t\treturn nil, errors.Wrapf(ctx, err, \"unmarshal pull request %s/%s#%d\", owner, repo, number)\n80\t\t}\n81\t\treturn &PullRequestInfo{Draft: payload.Draft, HeadSHA: payload.Head.SHA}, nil\n82\t}\n83\t\n84\tfunc (c *httpGitHubClient) ListPullRequestFiles(\n85\t\tctx context.Context,\n86\t\towner, repo string,\n87\t\tnumber int,\n88\t) ([]string, error) {\n89\t\turl := fmt.Sprintf(\"%s/repos/%s/%s/pulls/%d/files?per_page=100\", c.baseURL, owner, repo, number)\n90\t\tbody, err := c.get(ctx, url)\n91\t\tif err != nil {\n92\t\t\treturn nil, err\n93\t\t}\n94\t\tvar payload []struct {\n95\t\t\tFilename string `json:\"filename\"`\n96\t\t}\n97\t\tif err := json.Unmarshal(body, &payload); err != nil {\n98\t\t\treturn nil, errors.Wrapf(\n99\t\t\t\tctx,\n100\t\t\t\terr,\n101\t\t\t\t\"unmarshal pull request files %s/%s#%d\",\n102\t\t\t\towner,\n103\t\t\t\trepo,\n104\t\t\t\tnumber,\n105\t\t\t)\n106\t\t}\n107\t\tfiles := make([]string, 0, len(payload))\n108\t\tfor _, f := range payload {\n109\t\t\tfiles = append(files, f.Filename)\n110\t\t}\n111\t\treturn files, nil\n112\t}\n113\t\n114\t// currentToken returns the credential to authenticate with, preferring the live\n115\t// process value over the one captured at construction. Installation tokens\n116\t// expire after 60 minutes and the execution phase re-mints immediately before\n117\t// its push, so ai_review — which runs later in the same process — must read the\n118\t// refreshed value rather than the startup one.\n119\tfunc (c *httpGitHubClient) currentToken() string {\n120\t\tif live := os.Getenv(\"GH_TOKEN\"); live != \"\" {\n121\t\t\treturn live\n122\t\t}\n123\t\treturn c.token\n124\t}\n125\t\n126\t// get performs an authenticated GET and returns the body on HTTP 200.\n127\tfunc (c *httpGitHubClient) get(ctx context.Context, url string) ([]byte, error) {\n128\t\treq, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)\n129\t\tif err != nil {\n130\t\t\treturn nil, errors.Wrapf(ctx, err, \"build request\")\n131\t\t}\n132\t\treq.Header.Set(\"Accept\", \"application/vnd.github+json\")\n133\t\tif token := c.currentToken(); token != \"\" {\n134\t\t\treq.Header.Set(\"Authorization\", \"token \"+token)\n135\t\t}\n136\t\tresp, err := c.client.Do(req)\n137\t\tif err != nil {\n138\t\t\treturn nil, errors.Wrapf(ctx, err, \"github request\")\n139\t\t}\n140\t\tdefer func() { _ = resp.Body.Close() }()\n141\t\tbody, _ := io.ReadAll(resp.Body)\n142\t\tif resp.StatusCode != http.StatusOK {\n143\t\t\treturn nil, errors.Errorf(\n144\t\t\t\tctx,\n145\t\t\t\t\"github returned HTTP %d: %s\",\n146\t\t\t\tresp.StatusCode,\n147\t\t\t\ttruncate(string(body)),\n148\t\t\t)\n149\t\t}\n150\t\treturn body, nil\n151\t}\n152\t"}]},"parent_tool_use_id":null,"session_id":"ad01bb35-0bb9-465a-bce8-8503e77fa89d","uuid":"495b31bb-f589-4fa8-b2a9-ff2e9f854444","timestamp":"2026-11-27T12:45:41.461Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/pkg/github.go","content":"// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n// Use of this source code is governed by a BSD-style\n// license that can be found in the LICENSE file.\n\npackage pkg\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"io\"\n\t\"net/http\"\n\t\"os\"\n\t\"time\"\n\n\t\"github.com/bborbe/errors\"\n)\n\n// apiBaseURL is the GitHub REST API root. Overridable in tests via\n// newGitHubClient (export_test.go) so probes hit httptest instead.\nconst apiBaseURL = \"https://api.github.com\"\n\n// PullRequestInfo is the subset of the GitHub pull-request payload the\n// planning step needs: whether the PR is a draft and the SHA at its head.\ntype PullRequestInfo struct {\n\tDraft   bool\n\tHeadSHA string\n}\n\n// GitHubClient reads pull-request metadata from the GitHub REST API. Only the\n// read paths the planning-phase preconditions require are exposed.\n//\n//counterfeiter:generate -o ../mocks/github-client.go --fake-name GitHubClient . GitHubClient\ntype GitHubClient interface {\n\t// GetPullRequest returns the draft flag and head SHA for a PR.\n\tGetPullRequest(ctx context.Context, owner, repo string, number int) (*PullRequestInfo, error)\n\t// ListPullRequestFiles returns the repo-relative paths changed in a PR.\n\tListPullRequestFiles(ctx context.Context, owner, repo string, number int) ([]string, error)\n}\n\n// NewGitHubClient constructs a GitHubClient backed by the public GitHub REST\n// API. token authenticates the requests; empty means anonymous (fine for\n// public repos and for tests that stub the transport).\nfunc NewGitHubClient(token string) GitHubClient {\n\treturn newGitHubClient(token, apiBaseURL)\n}\n\nfunc newGitHubClient(token, baseURL string) *httpGitHubClient {\n\treturn &httpGitHubClient{\n\t\ttoken:   token,\n\t\tbaseURL: baseURL,\n\t\tclient:  &http.Client{Timeout: 15 * time.Second},\n\t}\n}\n\ntype httpGitHubClient struct {\n\ttoken   string\n\tbaseURL string\n\tclient  *http.Client\n}\n\nfunc (c *httpGitHubClient) GetPullRequest(\n\tctx context.Context,\n\towner, repo string,\n\tnumber int,\n) (*PullRequestInfo, error) {\n\turl := fmt.Sprintf(\"%s/repos/%s/%s/pulls/%d\", c.baseURL, owner, repo, number)\n\tbody, err := c.get(ctx, url)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tvar payload struct {\n\t\tDraft bool `json:\"draft\"`\n\t\tHead  struct {\n\t\t\tSHA string `json:\"sha\"`\n\t\t} `json:\"head\"`\n\t}\n\tif err := json.Unmarshal(body, &payload); err != nil {\n\t\treturn nil, errors.Wrapf(ctx, err, \"unmarshal pull request %s/%s#%d\", owner, repo, number)\n\t}\n\treturn &PullRequestInfo{Draft: payload.Draft, HeadSHA: payload.Head.SHA}, nil\n}\n\nfunc (c *httpGitHubClient) ListPullRequestFiles(\n\tctx context.Context,\n\towner, repo string,\n\tnumber int,\n) ([]string, error) {\n\turl := fmt.Sprintf(\"%s/repos/%s/%s/pulls/%d/files?per_page=100\", c.baseURL, owner, repo, number)\n\tbody, err := c.get(ctx, url)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tvar payload []struct {\n\t\tFilename string `json:\"filename\"`\n\t}\n\tif err := json.Unmarshal(body, &payload); err != nil {\n\t\treturn nil, errors.Wrapf(\n\t\t\tctx,\n\t\t\terr,\n\t\t\t\"unmarshal pull request files %s/%s#%d\",\n\t\t\towner,\n\t\t\trepo,\n\t\t\tnumber,\n\t\t)\n\t}\n\tfiles := make([]string, 0, len(payload))\n\tfor _, f := range payload {\n\t\tfiles = append(files, f.Filename)\n\t}\n\treturn files, nil\n}\n\n// currentToken returns the credential to authenticate with, preferring the live\n// process value over the one captured at construction. Installation tokens\n// expire after 60 minutes and the execution phase re-mints immediately before\n// its push, so ai_review — which runs later in the same process — must read the\n// refreshed value rather than the startup one.\nfunc (c *httpGitHubClient) currentToken() string {\n\tif live := os.Getenv(\"GH_TOKEN\"); live != \"\" {\n\t\treturn live\n\t}\n\treturn c.token\n}\n\n// get performs an authenticated GET and returns the body on HTTP 200.\nfunc (c *httpGitHubClient) get(ctx context.Context, url string) ([]byte, error) {\n\treq, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)\n\tif err != nil {\n\t\treturn nil, errors.Wrapf(ctx, err, \"build request\")\n\t}\n\treq.Header.Set(\"Accept\", \"application/vnd.github+json\")\n\tif token := c.currentToken(); token != \"\" {\n\t\treq.Header.Set(\"Authorization\", \"token \"+token)\n\t}\n\tresp, err := c.client.Do(req)\n\tif err != nil {\n\t\treturn nil, errors.Wrapf(ctx, err, \"github request\")\n\t}\n\tdefer func() { _ = resp.Body.Close() }()\n\tbody, _ := io.ReadAll(resp.Body)\n\tif resp.StatusCode != http.StatusOK {\n\t\treturn nil, errors.Errorf(\n\t\t\tctx,\n\t\t\t\"github returned HTTP %d: %s\",\n\t\t\tresp.StatusCode,\n\t\t\ttruncate(string(body)),\n\t\t)\n\t}\n\treturn body, nil\n}\n","numLines":152,"startLine":1,"totalLines":152}}}
