e requested wait exceeds MaxWait\", func() {\n\t\tvar requests int32\n\t\tsrv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {\n\t\t\tatomic.AddInt32(&requests, 1)\n\t\t\tw.Header().Set(\"Retry-After\", \"60\")\n\t\t\tw.WriteHeader(http.StatusTooManyRequests)\n\t\t}))\n\t\tDeferCleanup(srv.Close)\n\n\t\tclient := pkg.NewGitHubClientWithBaseURL(\"tok\", srv.URL)\n\t\tstart := time.Now()\n\t\t_, err := client.GetPullRequest(ctx, \"bborbe\", \"sandbox\", 7)\n\t\telapsed := time.Since(start)\n\t\tExpect(err).NotTo(BeNil())\n\t\tExpect(err.Error()).To(ContainSubstring(\"HTTP 429\"))\n\t\tExpect(atomic.LoadInt32(&requests)).To(Equal(int32(1)))\n\t\tExpect(elapsed).To(BeNumerically(\"<\", 5*time.Second))\n\t})\n\n\tIt(\"does not retry a plain 403\", func() {\n\t\tvar requests int32\n\t\tsrv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {\n\t\t\tatomic.AddInt32(&requests, 1)\n\t\t\tw.WriteHeader(http.StatusForbidden)\n\t\t\t_, _ = w.Write([]byte(`{\"message\":\"Forbidden\"}`))\n\t\t}))\n\t\tDeferCleanup(srv.Close)\n\n\t\tclient := pkg.NewGitHubClientWithBaseURL(\"tok\", srv.URL)\n\t\t_, err := client.GetPullRequest(ctx, \"bborbe\", \"sandbox\", 7)\n\t\tExpect(err).NotTo(BeNil())\n\t\tExpect(err.Error()).To(ContainSubstring(\"HTTP 403\"))\n\t\tExpect(atomic.LoadInt32(&requests)).To(Equal(int32(1)))\n\t})\n})"}}],"model":"deepseek-v4-flash","stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"ad01bb35-0bb9-465a-bce8-8503e77fa89d","uuid":"b242627b-e88c-477c-af4f-2cae299210d8","timestamp":"2026-11-27T12:46:22.926Z"}
