ation header when neither a live nor a captured token exists\", func() {\n48\t\t\t// Public repos need no credential; an empty header must not become a\n49\t\t\t// bare \"token \" prefix that GitHub rejects.\n50\t\t\tsrv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n51\t\t\t\tExpect(r.Header.Get(\"Authorization\")).To(BeEmpty())\n52\t\t\t\t_, _ = w.Write([]byte(`{\"draft\":true,\"head\":{\"sha\":\"abc123\"}}`))\n53\t\t\t}))\n54\t\t\tDeferCleanup(srv.Close)\n55\t\n56\t\t\tclient := pkg.NewGitHubClientWithBaseURL(\"\", srv.URL)\n57\t\t\t_, err := client.GetPullRequest(ctx, \"bborbe\", \"sandbox\", 7)\n58\t\t\tExpect(err).To(BeNil())\n59\t\t})\n60\t\n61\t\tIt(\"GetPullRequest parses draft flag and head sha\", func() {\n62\t\t\tsrv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n63\t\t\t\tExpect(r.URL.Path).To(Equal(\"/repos/bborbe/sandbox/pulls/7\"))\n64\t\t\t\tExpect(r.Header.Get(\"Authorization\")).To(Equal(\"token tok\"))\n65\t\t\t\t_, _ = w.Write([]byte(`{\"draft\":true,\"head\":{\"sha\":\"abc123\"}}`))\n66\t\t\t}))\n67\t\t\tDeferCleanup(srv.Close)\n68\t\n69\t\t\tclient := pkg.NewGitHubClientWithBaseURL(\"tok\", srv.URL)\n70\t\t\tinfo, err := client.GetPullRequest(ctx, \"bborbe\", \"sandbox\", 7)\n71\t\t\tExpect(err).To(BeNil())\n72\t\t\tExpect(info.Draft).To(BeTrue())\n73\t\t\tExpect(info.HeadSHA).To(Equal(\"abc123\"))\n74\t\t})\n75\t\n76\t\tIt(\"ListPullRequestFiles parses filenames\", func() {\n77\t\t\tsrv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {\n78\t\t\t\t_, _ = w.Write(\n79\t\t\t\t\t[]byte(`[{\"filename\":\"specs/in-progress/foo.md\"},{\"filename\":\"README.md\"}]`),\n80\t\t\t\t)\n81\t\t\t}))\n82\t\t\tDeferCleanup(srv.Close)\n83\t\n84\t\t\tclient := pkg.NewGitHubClientWithBaseURL(\"tok\", srv.URL)\n85\t\t\tfiles, err := client.ListPullRequestFiles(ctx, \"bborbe\", \"sandbox\", 7)\n86\t\t\tExpect(err).To(BeNil())\n87\t\t\tExpect(files).T