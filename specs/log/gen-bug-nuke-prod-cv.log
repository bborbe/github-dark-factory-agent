// license that can be found in the LICENSE file.

package errors

func Unwrap(err error) error {
	for {
		switch e := err.(type) {
		case interface{ Unwrap() error }:
			err = e.Unwrap()
		case interface{ Unwrap() []error }:
			if errs := e.Unwrap(); len(errs) > 0 {
				err = errs[0]
			}
		case interface{ Cause() error }:
			err = e.Cause()
		default:
			return err
		}
	}
}
