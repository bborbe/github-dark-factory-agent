Do not remove or weaken `TestPrintRedactsAnthropicAuthToken`.

### 7e. Add `TestSentryFingerprintProcessorThroughCapture` (boundary test)

The processor is registered through the global registry, so 7d proves only the
transformation — not that the registered processor is invoked by the real
capture path or that `EventHint.OriginalException` carries the `*statusError`.
Drive a real `sentry.Client` with a fake `Transport`:

```go
type captureTransport struct {
	event *sentry.Event
}

func (t *captureTransport) Configure(sentry.ClientOptions)          {}
func (t *captureTransport) SendEvent(event *sentry.Event)          { t.event = event }
func (t *captureTransport) Flush(time.Duration) bool               { return true }
func (t *captureTransport) FlushWithContext(context.Context) bool  { return true }
func (t *captureTransport) Close()                                 {}

func TestSentryFingerprintProcessorThroughCapture(t *testing.T) {
	ctx := context.Background()
	transport := &captureTransport{}
	client, err := sentry.NewClient(sentry.ClientOptions{
		Dsn:       "http://public@example.com/1",
		Transport: transport,
	})
	if err != nil {
		t.Fatalf("new client: %v", err)
	}
	defer client.Close()
	sentry.AddGlobalEventProcessor(sentryFingerprintProcessor)

	statusErr := exitErrorForStatus(
		ctx,
		agentlib.AgentStatusFailed,
		domain.TaskPhase("execution"),
		"execution: ensure worktree: clone boom",
	)
	client.CaptureException(statusErr, &sentry.EventHint{OriginalException: statusErr}, sentry.NewScope())
	client.Flush(2 * time.Second)

	if transport.event == nil {
		t.Fatal("no event captured")
	}
	want := []string{"agent-status-failed", "execution", "execution: ensure worktree: clone boom"}
	if !slices.Equal(transport.event.Fingerprint, want) {
		t.Fatalf("fingerprint = %v, want %v", transport.event.Fingerprint, want)
	}
}
```

