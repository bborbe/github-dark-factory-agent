func DataFromError(err error) map[string]any {
	data := make(map[string]any)
	for err != nil {
		hasData, ok := err.(HasData)
		if ok {
			for k, v := range hasData.Data() {
				data[k] = v
			}
		}
		hasCause, ok := err.(HasCause)
		if !ok {
			break
		}
		err = hasCause.Cause()
	}
	return data
}
